<!DOCTYPE html>
<html lang="fr"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#111214">
<title>MotoHelp</title>
<style>
:root{color-scheme:dark;--bg:#111214;--card:#1c1e22;--line:#2b2e34;--or:#ff6a00;--tx:#fff;--mu:#9aa0a8;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box}html,body{margin:0;background:var(--bg);color:var(--tx);font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif}
main{max-width:520px;margin:0 auto;padding:16px 16px 120px}
h1{font-size:22px;margin:0}h2{font-size:18px;margin:18px 0 8px}small,.mu{color:var(--mu)}
.logo{color:var(--or);font-weight:800;letter-spacing:1px}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px;margin:10px 0}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.btn{background:var(--or);color:#fff;border:0;border-radius:12px;padding:12px 16px;font-weight:700;font-size:15px;width:100%;cursor:pointer}
.btn.alt{background:transparent;border:1px solid var(--or);color:var(--or)}
.big{min-height:130px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;font-size:16px;border-radius:18px}.big span{font-size:38px}
input,select,textarea{width:100%;background:#0c0d0f;color:#fff;border:1px solid var(--line);border-radius:10px;padding:11px;margin:5px 0;font:inherit}
.tag{display:inline-block;font-size:12px;padding:2px 8px;border-radius:99px;background:#2a1b10;color:var(--or);margin-right:6px}
nav{position:fixed;left:12px;right:12px;bottom:calc(12px + env(safe-area-inset-bottom,0px));max-width:496px;margin:0 auto;background:rgba(28,30,34,.94);backdrop-filter:blur(12px);border:1px solid var(--line);border-radius:28px;display:flex;align-items:flex-end;padding:6px;box-shadow:0 8px 24px rgba(0,0,0,.55)}
nav button{flex:1;background:none;border:0;color:var(--mu);padding:8px 0;font-size:9px;font-weight:700;cursor:pointer;border-radius:20px}
nav button.on{color:var(--or);background:#2a1b10}nav span{display:block;font-size:20px}
nav button.mid{flex:0 0 66px;height:66px;margin-top:-28px;padding:0;background:var(--or);color:#fff;border-radius:50%;box-shadow:0 0 0 5px var(--bg),0 6px 18px rgba(255,106,0,.5)}nav button.mid span{font-size:26px}
.warn{border-left:4px solid var(--or)}ul{padding-left:20px;margin:6px 0}li{margin:4px 0}
img.pv{width:100%;border-radius:12px;margin:8px 0}
</style></head><body>
<main id="app"></main><nav id="nav"></nav>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.58.0/dist/umd/supabase.js"></script>
<script>
var sb=supabase.createClient("https://eonpkjiirluoaenlbzhh.supabase.co","sb_publishable_-DDHp86PxnOJ-0qXWckzHQ_iawikZEV");
var TABS={home:["🏠","ACCUEIL"],tuto:["📚","TUTORIELS"],diag:["📷","DIAGNOSTIC"],moto:["🏍️","MA MOTO"],acc:["👤","MON COMPTE"]};
var TUTOS=[
["Faire une vidange","Moyen","45 min","Clé adaptée au bouchon, bac de récupération, entonnoir, joint neuf","Huile et filtre selon le manuel","Moteur chaud puis arrêté, moto stable et droite"],
["Changer les plaquettes de frein","Moyen","30 min","Clés Allen, chasse-goupille, nettoyant frein","Plaquettes compatibles avec le modèle","Ne jamais rouler sans avoir pompé le levier"],
["Nettoyer un filtre à air","Facile","20 min","Tournevis, gants","Huile filtre, nettoyant filtre","Aucun résidu ne doit entrer dans l’admission"],
["Tendre une chaîne","Facile","20 min","Clés plates, règle","Aucun","Roue bien alignée après réglage"],
["Graisser une chaîne","Facile","10 min","Chiffon","Graisse chaîne, nettoyant","Moteur à l’arrêt, éviter les projections sur les freins"],
["Changer une bougie","Facile","15 min","Clé à bougie","Bougie préconisée","Moteur froid, ne pas forcer au serrage"],
["Contrôler les niveaux","Facile","10 min","Chiffon","Selon besoin","Moto droite sur béquille d’atelier"],
["Changer une poignée","Facile","20 min","Tournevis, colle ou fil de frein","Poignée neuve","Vérifier le retour libre de la poignée d’accélérateur"],
["Contrôler les pneus","Facile","10 min","Manomètre, jauge","Aucun","Contrôler usure, coupures et pression"],
["Contrôler l’état des freins","Facile","15 min","Lampe, pied à coulisse","Aucun","En cas de doute, voir un mécanicien"]];
var tab="home",open=-1,preview=null,result=null,U=null,motos=[],log=[],msg="";
function esc(s){return String(s==null?"":s).replace(/[&<>"]/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]})}
function v(i){return document.getElementById(i).value.trim()}
function go(t){tab=t;msg="";render();scrollTo(0,0)}
function head(){return '<div class="logo">MOTOHELP</div><small>La mécanique tout simplement.</small>'}
function note(){return msg?'<div class="card warn"><small style="color:#fff">'+esc(msg)+'</small></div>':''}
async function init(){try{var r=await sb.auth.getSession();U=r.data.session?r.data.session.user:null;if(U)await load()}catch(e){msg="Connexion impossible : "+e.message}render()}
async function load(){var a=await sb.from("motos").select("*").order("created_at"),b=await sb.from("entretiens").select("*").order("created_at",{ascending:false});
if(a.error||b.error)msg="Erreur base de données : "+(a.error||b.error).message;motos=a.data||[];log=b.data||[];render()}
async function auth(mode){var e=v("le"),p=document.getElementById("lp").value;msg="Patiente un instant...";render();try{await auth2(mode,e,p)}catch(x){msg="Erreur : "+(x&&x.message?x.message:x);render()}}
async function auth2(mode,e,p){
if(!e||p.length<6){msg="Entre un e-mail et un mot de passe de 6 caractères minimum.";render();return}
var r=mode=="up"?await sb.auth.signUp({email:e,password:p}):await sb.auth.signInWithPassword({email:e,password:p});
if(r.error){msg=r.error.message;render();return}
if(!r.data.session){msg="Compte créé ! Confirme ton adresse via l’e-mail reçu, puis connecte-toi.";render();return}
U=r.data.user;msg="";await load()}
async function logout(){await sb.auth.signOut();U=null;motos=[];log=[];tab="home";render()}
function login(){return head()+'<h1 style="margin-top:16px">Connexion</h1><div class="card"><input id="le" type="email" placeholder="Adresse e-mail" autocomplete="email"><input id="lp" type="password" placeholder="Mot de passe (6 caractères min.)" autocomplete="current-password"><br><button class="btn" onclick="auth(\'in\')">Se connecter</button><br><br><button class="btn alt" onclick="auth(\'up\')">Créer un compte</button></div>'+note()}
function home(){var m=motos[0];
return head()+'<h1 style="margin-top:16px">Salut pilote 👋</h1>'+note()+
'<div class="card">'+(m?'<b>'+esc(m.marque+" "+m.modele)+'</b> <small>'+esc(m.annee)+' · '+esc(m.cylindree)+' cc</small><br><small>Heures moteur : '+Number(m.heures)+' h</small>':'<b>Aucune moto enregistrée</b><br><small>Ajoute ta moto pour des conseils adaptés.</small><br><br><button class="btn alt" onclick="go(\'moto\')">Ajouter ma moto</button>')+'</div>'+
'<h2>Accès rapides</h2><div class="grid"><button class="btn big" onclick="go(\'diag\')"><span>📷</span>Diagnostic photo</button><button class="btn big" onclick="go(\'tuto\')"><span>📚</span>Tutoriels</button><button class="btn alt big" onclick="go(\'moto\')"><span>🛠️</span>Entretien</button><button class="btn alt big" onclick="go(\'diag\')"><span>💬</span>Assistant</button></div>'+
'<div class="card warn" style="margin-top:16px"><b>Sécurité d’abord</b><br><small>MotoHelp n’invente jamais un couple de serrage ou une quantité d’huile. En cas de doute, consulte le manuel constructeur ou un mécanicien.</small></div>'}
function diag(){return head()+'<h1 style="margin-top:16px">Diagnostic</h1><div class="card"><label class="mu">1. Photo de la pièce</label><input type="file" accept="image/*" onchange="pick(this)">'+(preview?'<img class="pv" src="'+preview+'">':'')+'<label class="mu">2. Ta moto</label><input id="dm" placeholder="Marque, modèle, année, cylindrée" value="'+esc(motos[0]?motos[0].marque+" "+motos[0].modele+" "+(motos[0].annee||""):"")+'"><label class="mu">3. Ton problème</label><textarea id="dp" rows="3" placeholder="Ex. : la chaîne claque, elle semble trop lâche"></textarea><button class="btn" onclick="analyse()">Analyser</button></div>'+(result?'<div class="card warn"><span class="tag">Maquette</span><br>'+result+'</div>':'')+'<div class="card"><small>Un diagnostic par photo a des limites : il donne une piste, jamais une garantie de réparation.</small></div>'}
function pick(i){var f=i.files[0];if(!f)return;var rd=new FileReader();rd.onload=function(){preview=rd.result;render()};rd.readAsDataURL(f)}
function analyse(){var p=v("dp"),m=v("dm");if(!preview||!p){result="Ajoute une photo et décris ton problème.";render();return}
result="<b>IA pas encore connectée (Phase 4).</b><br>Elle recevrait ta photo, ta moto (<i>"+esc(m||"non précisée")+"</i>) et ta description (<i>"+esc(p)+"</i>).";render()}
function tuto(){return head()+'<h1 style="margin-top:16px">Tutoriels</h1><small>Étapes vérifiées sur le modèle exact : à ajouter en Phase 3.</small>'+TUTOS.map(function(t,i){var o=open==i;return '<div class="card" onclick="tg('+i+')"><b>'+t[0]+'</b><br><span class="tag">'+t[1]+'</span><span class="tag">⏱ '+t[2]+'</span>'+(o?'<ul><li><b>Outils :</b> '+t[3]+'</li><li><b>Pièces et consommables :</b> '+t[4]+'</li><li><b>Précaution :</b> '+t[5]+'</li></ul><small>Étapes détaillées et valeurs constructeur : à saisir depuis la documentation officielle.</small>':'')+'</div>'}).join("")}
function tg(i){open=open==i?-1:i;render()}
function moto(){var m=motos[0],h=head()+'<h1 style="margin-top:16px">Ma moto</h1>'+note();
if(!m)return h+'<div class="card"><input id="a1" placeholder="Marque (ex. KTM)"><input id="a2" placeholder="Modèle"><input id="a3" placeholder="Année" inputmode="numeric"><input id="a4" placeholder="Cylindrée (cc)" inputmode="numeric"><select id="a5"><option>4 temps</option><option>2 temps</option></select><br><button class="btn" onclick="addMoto()">Enregistrer</button></div>';
var L=log.filter(function(l){return l.moto_id==m.id});
return h+'<div class="card"><b>'+esc(m.marque+" "+m.modele)+'</b><br><small>'+esc(m.annee)+' · '+esc(m.cylindree)+' cc · '+esc(m.type_moteur)+'</small><br><br>Heures moteur : <b>'+Number(m.heures)+' h</b><div class="grid" style="margin-top:8px"><button class="btn alt" onclick="hrs(0.5)">+0,5 h</button><button class="btn alt" onclick="hrs(1)">+1 h</button></div></div>'+
'<h2>Historique d’entretien</h2><div class="card"><select id="lt"><option>Vidange</option><option>Filtre à air</option><option>Chaîne</option><option>Plaquettes</option><option>Bougie</option><option>Autre</option></select><button class="btn" onclick="addLog()">Ajouter à l’historique</button></div>'+
(L.length?L.map(function(l){return '<div class="card">'+esc(l.type)+' <small>· '+new Date(l.created_at).toLocaleDateString("fr-FR")+' · '+Number(l.heures_moteur)+' h</small></div>'}).join(""):'<small>Aucune intervention enregistrée.</small>')+
'<br><button class="btn alt" onclick="delMoto()">Supprimer ma moto</button>'}
async function addMoto(){if(!v("a1")||!v("a2"))return;var r=await sb.from("motos").insert({marque:v("a1"),modele:v("a2"),annee:parseInt(v("a3"))||null,cylindree:parseInt(v("a4"))||null,type_moteur:v("a5")});if(r.error)msg=r.error.message;await load()}
async function hrs(n){var r=await sb.from("motos").update({heures:Number(motos[0].heures)+n}).eq("id",motos[0].id);if(r.error)msg=r.error.message;await load()}
async function addLog(){var r=await sb.from("entretiens").insert({moto_id:motos[0].id,type:v("lt"),heures_moteur:motos[0].heures});if(r.error)msg=r.error.message;await load()}
async function delMoto(){if(!confirm("Supprimer la moto et son historique ?"))return;var r=await sb.from("motos").delete().eq("id",motos[0].id);if(r.error)msg=r.error.message;await load()}
function acc(){return head()+'<h1 style="margin-top:16px">Mon compte</h1><div class="card"><b>Connecté</b><br><small>'+esc(U.email)+'</small><br><br><button class="btn alt" onclick="logout()">Se déconnecter</button></div><div class="card"><b>Offre gratuite</b><ul><li>Quelques tutoriels</li><li>Diagnostics limités</li><li>Entretien de base</li></ul></div><div class="card warn"><b>Premium · 4,99 €/mois</b><ul><li>Plus de diagnostics IA</li><li>Tutoriels complets</li><li>Assistance personnalisée</li><li>Historique avancé</li></ul><button class="btn" onclick="alert(\'Paiement à brancher plus tard (Phase 6).\')">Passer Premium</button></div>'}
function render(){var n=document.getElementById("nav"),a=document.getElementById("app");
if(!U){a.innerHTML=login();n.innerHTML="";return}
var f={home:home,diag:diag,tuto:tuto,moto:moto,acc:acc};a.innerHTML=f[tab]();
n.innerHTML=["home","tuto","diag","moto","acc"].map(function(k){return '<button class="'+(k==tab?"on ":"")+(k=="diag"?"mid":"")+'" onclick="go(\''+k+'\')"><span>'+TABS[k][0]+'</span>'+TABS[k][1]+'</button>'}).join("")}
window.onerror=function(m){msg="Erreur : "+m;try{render()}catch(x){}};
window.addEventListener("unhandledrejection",function(ev){msg="Erreur : "+(ev.reason&&ev.reason.message?ev.reason.message:ev.reason);render()});
init();
</script></body></html>
